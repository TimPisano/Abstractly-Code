# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
*.egg-info/
dist/
build/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test files
tests/sample_lease.pdf

# Generated synthetic test corpus (tests/generate_synthetic_corpus.py) —
# a generator, not a committed fixture set. Re-run with the same --seed
# for the same files.
tests/synthetic_corpus/
tests/synthetic_corpus_*/

# Training-loop output (tools/training_harness.py). The trend lives in
# the training_rounds DB table / owner console; these markdown reports
# are per-run artifacts.
training_reports/

# Temp files
*.tmp
*.log

# Runtime database (portfolio data — not test fixtures, not committed)
*.db
*.db-journal

# Real secrets (Gmail App Password, etc) — see .env.example for the
# variable names this project expects. Never commit the real file.
.env

# Google service account key (Sheets/Drive API export) — a real key
# file here would grant whoever has it write access to Google Sheets as
# this app. See .env.example for the exact env var / expected path.
credentials/*.json
