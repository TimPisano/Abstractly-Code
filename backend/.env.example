# Copy this file to `.env` in this same directory (backend/.env) and
# fill in real values. `.env` is gitignored — never commit real
# credentials.
#
# These two variables power real email sending (backend/app/email_service.py,
# sent via Gmail SMTP) for two things:
#   1. A confirmation email to whoever submits the "Request Access" form.
#   2. A notification email to ADMIN_EMAIL (see the admin login section
#      below) so you actually find out a request came in, rather than
#      having to keep the admin dashboard open and refreshing it.
#
# EMAIL_USER: the Gmail address emails are sent FROM (also doubles as
# the admin notification's default look-and-feel sender identity).
EMAIL_USER=timmypisano24@gmail.com

# EMAIL_APP_PASSWORD: a Gmail App Password — NOT your regular Gmail
# password. Generate one at:
#   Google Account > Security > 2-Step Verification > App Passwords
# (2-Step Verification must already be turned on for that option to
# appear.) It's a 16-character code Google generates for you; paste it
# here exactly as shown, spaces or no spaces both work.
EMAIL_APP_PASSWORD=

# If either variable above is missing, waitlist signups still work
# normally — both emails are simply skipped, and a warning is logged
# server-side (see email_service.py). No signup is ever blocked by an
# email problem. The admin notification also needs ADMIN_EMAIL (below)
# set to know who to send to — same fail-open behavior if it's missing.

# ---- First admin account seed (one-time only, real accounts live in ----
# ---- the `users` table from then on -- see app/database.py's       ----
# ---- _seed_first_admin_user and app/auth.py)                       ----
#
# ADMIN_EMAIL: also doubles as the waitlist notification recipient
# above. For auth purposes, it's ONLY read the very first time this
# app starts against a brand-new, empty database -- it seeds exactly
# one admin-role row into the `users` table, then has no further
# effect. Change/add admins afterward through the Team view
# (POST /team/members), not by editing this file.
ADMIN_EMAIL=timmypisano24@gmail.com

# ADMIN_PASSWORD_HASH: a bcrypt hash of that first admin's password --
# never the real password itself. Generate one by running, from backend/:
#   venv/bin/python3 set_admin_password.py
# It prompts for a password with getpass (not echoed to the screen or
# saved to shell history) and prints the exact line to paste here.
#
# Same one-time-seed-only rule as ADMIN_EMAIL above: once a `users` row
# exists (from the seed, or from anyone signing up), this value is
# never read again. To change an existing admin's password, use
# POST /auth/change-password (as that admin) or the Team view's reset
# action (as another admin), not this file.
ADMIN_PASSWORD_HASH=

# FLASK_SECRET_KEY: signs the session cookie every team member's login
# uses. If left unset, a random key is generated each time the backend starts, which works
# fine but logs every admin out on every restart. Generate a real,
# stable one with:
#   venv/bin/python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# ADMIN_ALLOWED_ORIGINS: comma-separated list of frontend origins
# allowed to send credentialed (cookie-bearing) requests for the admin
# login/dashboard. Defaults to the two local-dev origins
# (http://localhost:8000 and http://127.0.0.1:8000) if left unset --
# only needs changing once there's a real deployed frontend domain.
# ADMIN_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# LOCAL_DEV_MODE: set to "true" to skip the /app access gate on this
# machine only, so you can reach the dashboard directly instead of
# going through the waitlist/approval flow every time. Read once at
# process start (see api.py) -- a client can never set this itself via
# a request. Leave unset (or "false") anywhere the real gate should be
# enforced, including any deployed environment. Never set this to true
# outside of local development.
LOCAL_DEV_MODE=false

# GOOGLE_APPLICATION_CREDENTIALS: path to a Google service account JSON
# key file, used by the "Export to Google Sheets" button (Portfolio
# Report view) to create a new Sheet and write your lease data into it.
# This is the standard env var name Google's own client libraries look
# for -- not invented for this project.
#
# One-time setup (nothing here works until you do this):
#   1. Go to https://console.cloud.google.com and create a project (or
#      pick an existing one).
#   2. In "APIs & Services" > "Library", enable BOTH:
#        - Google Sheets API
#        - Google Drive API
#      (Drive API is needed too -- it's what makes the created Sheet's
#      link actually open for you; Sheets API alone can't set sharing.)
#   3. In "APIs & Services" > "Credentials", create a Service Account.
#      Give it any name (e.g. "lease-portfolio-export"). On its "Keys"
#      tab, "Add Key" > "Create new key" > JSON -- this downloads a
#      .json file. Save it as:
#        backend/credentials/google-service-account.json
#      (that whole directory's *.json files are gitignored -- see
#      backend/credentials/README.md)
#   4. Point this variable at that file:
GOOGLE_APPLICATION_CREDENTIALS=backend/credentials/google-service-account.json

# Nothing else needs sharing for this feature specifically -- unlike
# updating one persistent sheet, a NEW sheet is created fresh on every
# export (named "Lease Portfolio Export - [date]") and shared as
# "anyone with the link can view" so the link handed back to you always
# opens. That does mean anyone who obtains that exact link (not
# guessable, but also not access-controlled) could view that export's
# data -- the same tradeoff the existing CSV/report exports already
# have, not a new one.
#
# If this variable is unset, or the file it points to doesn't exist, or
# the Sheets/Drive APIs return a permission error (e.g. not enabled
# yet), the export button shows a clear error -- it never crashes the
# app or blocks anything else.
